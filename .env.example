# ==========================================
# STASHED • CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# ==========================================

# 1. Base de Données (Neon / Vercel Postgres / Supabase)
# Création gratuite en 1 clic sur https://neon.tech ou dans le dashboard Vercel Storage
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentification Propriétaire
# Mot de passe pour se connecter au Dashboard Stashed sur /login
OWNER_PASSPHRASE="stashed2026"
# Clé secrète de signature des sessions JWT (générez une chaîne aléatoire)
AUTH_SECRET="stashed_super_secure_daw_glass_jwt_key_2026_change_me"

# 3. Stockage Fichiers Audio (.wav, .mp3) & Pochettes
# OPTION A : Vercel Blob (inclus directement dans Vercel, 1 Go gratuit)
# S'ajoute automatiquement via "Vercel Blob" dans l'onglet Storage de Vercel
BLOB_READ_WRITE_TOKEN=""

# OPTION B (RECOMMANDÉE POUR GROS FICHIERS AUDIO) : Cloudflare R2
# 10 Go gratuits par mois + 0$ de bande passante / egress illimitée !
# Idéal pour du streaming .wav lourd. Créez un bucket R2 sur https://dash.cloudflare.com
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""
